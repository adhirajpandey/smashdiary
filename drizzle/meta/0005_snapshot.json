      "checkConstraints": {
        "games_slot_check": {
          "name": "games_slot_check",
          "value": "\"games\".\"slot\" in ('12 AM', '1 AM', '2 AM', '3 AM', '4 AM', '5 AM', '6 AM', '7 AM', '8 AM', '9 AM', '10 AM', '11 AM', '12 PM', '1 PM', '2 PM', '3 PM', '4 PM', '5 PM', '6 PM', '7 PM', '8 PM', '9 PM', '10 PM', '11 PM')"
        },
        "games_format_check": {
          "name": "games_format_check",
          "value": "\"games\".\"format\" in ('singles', 'doubles')"
        },
        "games_winner_side_check": {
          "name": "games_winner_side_check",
          "value": "\"games\".\"winner_side\" in ('A', 'B')"
        },
        "games_roster_shape_check": {
          "name": "games_roster_shape_check",
          "value": "\n        (\"games\".\"format\" = 'singles' and \"games\".\"side_a_player_2_id\" is null and \"games\".\"side_b_player_2_id\" is null)\n        or\n        (\"games\".\"format\" = 'doubles' and \"games\".\"side_a_player_2_id\" is not null and \"games\".\"side_b_player_2_id\" is not null)\n      "
        },
        "games_unique_players_check": {
          "name": "games_unique_players_check",
          "value": "\n        (\"games\".\"side_a_player_2_id\" is null or \"games\".\"side_a_player_1_id\" <> \"games\".\"side_a_player_2_id\")\n        and \"games\".\"side_a_player_1_id\" <> \"games\".\"side_b_player_1_id\"\n        and (\"games\".\"side_b_player_2_id\" is null or \"games\".\"side_a_player_1_id\" <> \"games\".\"side_b_player_2_id\")\n        and (\"games\".\"side_a_player_2_id\" is null or \"games\".\"side_a_player_2_id\" <> \"games\".\"side_b_player_1_id\")\n        and (\"games\".\"side_a_player_2_id\" is null or \"games\".\"side_b_player_2_id\" is null or \"games\".\"side_a_player_2_id\" <> \"games\".\"side_b_player_2_id\")\n        and (\"games\".\"side_b_player_2_id\" is null or \"games\".\"side_b_player_1_id\" <> \"games\".\"side_b_player_2_id\")\n      "
        },
        "games_score_bounds_check": {
          "name": "games_score_bounds_check",
          "value": "\"games\".\"side_a_score\" between 0 and 30 and \"games\".\"side_b_score\" between 0 and 30"
        },
        "games_no_tie_check": {
          "name": "games_no_tie_check",
          "value": "\"games\".\"side_a_score\" <> \"games\".\"side_b_score\""
        },
        "games_winner_consistency_check": {
          "name": "games_winner_consistency_check",
          "value": "(\"games\".\"winner_side\" = 'A' and \"games\".\"side_a_score\" > \"games\".\"side_b_score\") or (\"games\".\"winner_side\" = 'B' and \"games\".\"side_b_score\" > \"games\".\"side_a_score\")"
        },
        "games_finish_rule_check": {
          "name": "games_finish_rule_check",
          "value": "\n        greatest(\"games\".\"side_a_score\", \"games\".\"side_b_score\") >= 21\n        and (\n          (greatest(\"games\".\"side_a_score\", \"games\".\"side_b_score\") = 21 and least(\"games\".\"side_a_score\", \"games\".\"side_b_score\") <= 19)\n          or (\n            greatest(\"games\".\"side_a_score\", \"games\".\"side_b_score\") between 22 and 29\n            and greatest(\"games\".\"side_a_score\", \"games\".\"side_b_score\") - least(\"games\".\"side_a_score\", \"games\".\"side_b_score\") = 2\n          )\n          or (\n            greatest(\"games\".\"side_a_score\", \"games\".\"side_b_score\") = 30\n            and least(\"games\".\"side_a_score\", \"games\".\"side_b_score\") = 29\n          )\n        )\n      "
        }
      },
